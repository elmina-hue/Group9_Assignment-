scores <- c(45, 72, 88, NA, 61, 95, 53)
normalize <- function(x, minimum, maximum, na.rm = TRUE) {
if (!is.numeric(x)) {
stop("x must be numeric")
}
if (any(is.na(x))) {
warning("Missing values detected")
}
if (na.rm) {
x <- x[!is.na(x)]
}
(x - minimum) / (maximum - minimum)
}
highest <- max(scores, na.rm = TRUE)
lowest <- min(scores, na.rm = TRUE)
normalized <- normalize(
scores,
minimum = lowest,
maximum = highest
)
result <- data.frame(
original = scores[!is.na(scores)],
normalized = normalized
)
result <- result |>
dplyr::mutate(
percentage = normalized * 100,
category = ifelse(normalized >= .5, "high", "low")
) |>
dplyr::arrange(desc(percentage))

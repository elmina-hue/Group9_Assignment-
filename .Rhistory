mutate(new_price = gsub(",", "", new_price)) %>%
mutate(new_price = ifelse(new_price == "Illegal", NA, new_price)) %>%
mutate(new_price = as.numeric(new_price)) %>%
mutate(new_aggression = recode(Aggression,
"High" = 3, "Medium" = 2, "Low" = 1)) %>%
mutate(overall = -new_aggression + Cuddleability -new_price + Intelligence + Prettiness) %>%

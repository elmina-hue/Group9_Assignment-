count_high = function(x, na.rm = TRUE) {
if(!is.numeric(x)) {
stop("Error: Input must be numeric!")
}
if(sum(is.na(x)) > 0) {
warning("There are missing values in the dataset")
}
if(na.rm) {
x = x[!is.na(x)]
}
return(x > 70)
}
count_high(50:100)
